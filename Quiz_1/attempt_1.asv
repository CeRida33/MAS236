%Geometric stress concentration factor. 
% Compute the geometric stress concentration factor for the detail 
% shown in Figure 08 with the dimensions:

D = 56; %mm
d = 39; %mm
r = 5.2; %mm

D_d = D/d; % 1.4359
r_d = r/d; % 0.1333

A_p = 1.13260;
b_p = -0.36592;

K_t = A_p*(r_d)^b_p

