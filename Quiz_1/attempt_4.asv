%% Task 1
clear; clc; close all;

%Geometric stress concentration factor. 
% Compute the geometric stress concentration factor for the detail 
% shown in Figure 08 with the dimensions:
%  D = 48mm, d = 31mm, and r = 3.8mm.

D = 48; %mm
d = 39; %mm
r = 3.8; %mm

D_d = D/d %  1.5484
r_d = r/d %  0.1226

A = 0.99682+((1.35-1.3)*((0.99957-0.99682)/(1.5-1.3)))
b = -0.25751+((1.35-1.3)*((-0.28221+0.25751)/(1.5-1.3)))

%A = 0.94681;
%b = -0.30582;

K_t = A*(r_d)^b
